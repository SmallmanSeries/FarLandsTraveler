          "persistent": "true",
          "waterlogged": "false"
        }
      }
    },
    "ignore_vines": true,
    "minimum_size": {
      "type": "minecraft:two_layers_feature_size",
      "limit": 1,
      "lower_size": 1,
      "upper_size": 1
    },
    "trunk_placer": {
      "type": "farlandstraveler:atlas_trunk_placer",
      "free_check_height": 12,
      "leaf_gap": 2,
